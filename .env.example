# VB-OS Cloud
VBOS_URL=https://api.vb-os.org
VBOS_API_KEY=
VBOS_PROJECT_ID=
VBOS_ENVIRONMENT_ID=

# Boundary IDs (optional, from template fork -- enables deployment staleness checks)
B1_BOUNDARY_ID=
B2_BOUNDARY_ID=
B3_BOUNDARY_ID=

# Local source systems
DATABASE_URL=postgresql://trading:trading@trading-postgres:5432/trading
GATEWAY_URL=http://trading-gateway:9093

# Alpaca Paper Trading (optional, required for --live mode)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Seed template (optional, for template registry administration)
VBOS_DATABASE_URL=postgresql+asyncpg://vbos:vbos@localhost:5432/vbos
