# VB-OS Cloud credentials
VBOS_API_URL=https://api.vbos.cloud
VBOS_API_KEY=
VBOS_PROJECT_ID=
VBOS_ENVIRONMENT_ID=

# PostgreSQL (set by docker-compose; override for local development)
DATABASE_URL=postgresql://trading:trading@trading-postgres:5432/trading

# Gateway (internal Docker network; override for local development)
GATEWAY_URL=http://trading-gateway:9093

# Alpaca Paper Trading (optional, required for --live mode)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Seed template (optional, for template registry)
VBOS_DATABASE_URL=postgresql+asyncpg://vbos:vbos@localhost:5432/vbos
